APP_ENV=development
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080
APP_LOCALE=en
APP_DEMO_MODE=true
APP_SESSION_NAME=nstructure_session

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nstructure
DB_USERNAME=nstructure
DB_PASSWORD=change_me

# Only used by the environmental sensors module (/tools/sensors) and its
# collector daemon, bin/sensors-daemon.php. See docs/DEPLOYMENT.md.
VICTORIAMETRICS_URL=http://127.0.0.1:8428
# SENSOR_HEARTBEAT_FILE=/dev/shm/nstructure-sensor-heartbeats.json

# Tuning for bin/sensors-daemon.php — every value below is the built-in
# default; uncomment only what you need to change.
# SENSOR_DAEMON_MAX_ITERATIONS=1000
# SENSOR_DAEMON_DEFAULT_INTERVAL=300
# SENSOR_DAEMON_FAST_INTERVAL=5
# SENSOR_DAEMON_KEEPALIVE_SECONDS=3600
# SENSOR_DAEMON_TEMP_HYSTERESIS=0.2
# SENSOR_DAEMON_HUMIDITY_HYSTERESIS=0.5
# SENSOR_DAEMON_LATENCY_HYSTERESIS=1.0
# SENSOR_DAEMON_BUFFER_MAX_LINES=5000
# SENSOR_DAEMON_LOCK_FILE=/tmp/nstructure-sensors-daemon.lock
# SENSOR_DAEMON_SNMP_TIMEOUT_US=1000000
# SENSOR_DAEMON_SNMP_RETRIES=1
# SENSOR_DAEMON_PING_TIMEOUT_MS=1000
