{% import 'components/icons.twig' as icons %}
{% set sensor_icon_picker_options = ['sensor-thermometer', 'sensor-droplet', 'sensor-gauge', 'sensor-scan', 'sensor-zap', 'sensor-siren', 'sensor-server', 'sensor-cabinet', 'sensor-building', 'sensor-warehouse', 'sensor-door', 'sensor-home'] %}
{% set sensor_icon_picker_current = selected|default('sensor-server') %}
<div class="icon-picker" data-icon-picker>
    <input type="hidden" name="icon" value="{{ sensor_icon_picker_current }}">
    {% for opt in sensor_icon_picker_options %}
    <button class="icon-picker-option{{ sensor_icon_picker_current == opt ? ' selected' : '' }}" type="button" data-icon-value="{{ opt }}" title="{{ t('sensor_icon.' ~ opt) }}" aria-label="{{ t('sensor_icon.' ~ opt) }}">{{ icons.icon(opt, 20) }}</button>
    {% endfor %}
</div>
