{% extends 'layouts/app.twig' %}
{% import 'components/icons.twig' as icons %}

{% block content %}
{% set sensor_model_field %}
<input type="hidden" name="model">
<label class="field"><span>{{ t('form.sensor_model') }}</span><select data-sensor-model-select>
    <option value="HWG_STE">HWg-STE</option>
    <option value="STE2_LITE">STE2 Lite</option>
    <option value="STE2">STE2 (3× temp. + wilg.)</option>
    <option value="STE2_R2">STE2 R2 (4× temp. + wilg.)</option>
    <option value="HWG_PWR">HWg-PWR</option>
    <option value="OTHER">{{ t('sensors.other_model') }}</option>
</select></label>
<label class="field" data-sensor-model-custom-field hidden><span>{{ t('form.sensor_model_custom') }}</span><input type="text" maxlength="80" data-sensor-model-custom placeholder="HWg-PWR, Poseidon2…"></label>
{% endset %}
{% set sensor_threshold_fields %}
<label class="field"><span>{{ t('form.sensor_temperature_min') }}</span><input name="temperature_min" type="number" step="0.01" placeholder="{{ t('form.sensor_no_limit') }}"></label>
<label class="field"><span>{{ t('form.sensor_temperature_max') }}</span><input name="temperature_max" type="number" step="0.01" placeholder="{{ t('form.sensor_no_limit') }}"></label>
<label class="field"><span>{{ t('form.sensor_humidity_min') }}</span><input name="humidity_min" type="number" step="0.01" placeholder="{{ t('form.sensor_no_limit') }}"></label>
<label class="field"><span>{{ t('form.sensor_humidity_max') }}</span><input name="humidity_max" type="number" step="0.01" placeholder="{{ t('form.sensor_no_limit') }}"></label>
{% endset %}
{% set sensor_channels_field %}
<div class="field field-wide sensor-channels-field">
    <span>{{ t('form.sensor_channels') }}</span>
    <div class="sensor-channel-rows" data-sensor-channel-rows></div>
    <button type="button" class="button button-ghost button-small" data-sensor-channel-add>{{ icons.icon('plus', 13) }}{{ t('action.add_channel') }}</button>
    <input type="hidden" name="channels" data-sensor-channels-json>
    <small>{{ t('form.sensor_channels_hint') }}</small>
</div>
{% endset %}
<template data-sensor-channel-row-template>
    <div class="sensor-channel-row" data-sensor-channel-row>
        <select data-channel-type>
            <option value="temperature">{{ t('sensors.channel_temperature') }}</option>
            <option value="humidity">{{ t('sensors.channel_humidity') }}</option>
        </select>
        <input type="text" maxlength="80" placeholder="{{ t('form.sensor_channel_label') }}" data-channel-label>
        <input type="text" maxlength="255" placeholder="1.3.6.1.4.1.21796.4.9.3.1.4.3" data-channel-oid>
        <input type="number" step="0.0001" value="1" placeholder="{{ t('form.sensor_divisor') }}" data-channel-divisor>
        <button type="button" class="icon-button danger" data-sensor-channel-remove aria-label="{{ t('action.delete') }}">{{ icons.icon('trash', 12) }}</button>
    </div>
</template>
<section class="page-hero compact-hero">
    <div><span class="eyebrow">{{ t('sensors.eyebrow') }}</span><h1>{{ t('sensors.title') }}</h1><p>{{ t('sensors.subtitle') }}</p></div>
    <div class="hero-actions"><button class="button button-ghost" type="button" data-sensor-grid-fullscreen aria-label="{{ t('action.fullscreen') }}" title="{{ t('action.fullscreen') }}" data-label-enter="{{ t('action.fullscreen') }}" data-label-exit="{{ t('action.exit_fullscreen') }}"><span data-fullscreen-icon-enter>{{ icons.icon('expand') }}</span><span data-fullscreen-icon-exit hidden>{{ icons.icon('shrink') }}</span><span data-fullscreen-button-label>{{ t('action.fullscreen') }}</span></button><button class="button button-ghost" type="button" data-sensors-refresh>{{ icons.icon('refresh-cw') }}{{ t('action.refresh') }}</button><button class="button button-primary" type="button" data-sensor-modal-open>{{ icons.icon('plus') }}{{ t('action.add_sensor') }}</button></div>
</section>

<div class="sensor-tabs" data-sensor-tabs>
    <button class="sensor-tab active" type="button" data-sensor-tab="list">{{ icons.icon('layers', 15) }}{{ t('sensors.tab_list') }}</button>
    <button class="sensor-tab" type="button" data-sensor-tab="charts">{{ icons.icon('activity', 15) }}{{ t('sensors.tab_charts') }}</button>
    <button class="sensor-tab" type="button" data-sensor-tab="alerts">{{ icons.icon('mail', 15) }}{{ t('sensors.tab_alerts') }}</button>
</div>

<section class="sensor-grid" data-sensor-grid data-sensor-panel="list" data-ping-down-label="{{ t('sensors.ping_down') }}" data-alarm-ping-label="{{ t('sensors.alarm_ping') }}" data-alarm-temperature-label="{{ t('sensors.alarm_temperature') }}" data-alarm-humidity-label="{{ t('sensors.alarm_humidity') }}" data-alarm-inputs-label="{{ t('sensors.alarm_inputs') }}" data-input-ok-label="{{ t('sensors.input_ok') }}" data-input-alarm-label="{{ t('sensors.input_alarm') }}" data-input-unknown-label="{{ t('sensors.input_unknown') }}">
    {% for sensor in sensors %}
    {% set temp_channel_breach = sensor.channels|filter(c => c.channel_type == 'temperature' and c.last_value is not null and ((sensor.temperature_min is not null and c.last_value < sensor.temperature_min) or (sensor.temperature_max is not null and c.last_value > sensor.temperature_max)))|length > 0 %}
    {% set humidity_channel_breach = sensor.channels|filter(c => c.channel_type == 'humidity' and c.last_value is not null and ((sensor.humidity_min is not null and c.last_value < sensor.humidity_min) or (sensor.humidity_max is not null and c.last_value > sensor.humidity_max)))|length > 0 %}
    {% set temp_alarm = temp_channel_breach or (sensor.last_temperature is not null and ((sensor.temperature_min is not null and sensor.last_temperature < sensor.temperature_min) or (sensor.temperature_max is not null and sensor.last_temperature > sensor.temperature_max))) %}
    {% set humidity_alarm = humidity_channel_breach or (sensor.last_humidity is not null and ((sensor.humidity_min is not null and sensor.last_humidity < sensor.humidity_min) or (sensor.humidity_max is not null and sensor.last_humidity > sensor.humidity_max))) %}
    {% set is_down = sensor.monitoring_enabled and sensor.last_ping_ok is not null and not sensor.last_ping_ok %}
    {% set miasto_inputs = sensor.inputs|filter(i => i.group == 'miasto') %}
    {% set agregat_inputs = sensor.inputs|filter(i => i.group == 'agregat') %}
    {% set miasto_alarm = miasto_inputs|filter(i => i.last_alarm_state == 2)|length > 0 %}
    {% set agregat_alarm = agregat_inputs|filter(i => i.last_alarm_state == 2)|length > 0 %}
    {% set has_input_data = sensor.inputs|filter(i => i.last_alarm_state is not null)|length > 0 %}
    {% set is_alarm = sensor.monitoring_enabled and (temp_alarm or humidity_alarm or is_down or miasto_alarm) %}
    {% set is_no_data = sensor.monitoring_enabled and sensor.last_temperature is null and sensor.last_humidity is null and not has_input_data %}
    {% set sensor_size = sensor_sizes[sensor.id] ?? 'medium' %}
    <article class="card sensor-tile size-{{ sensor_size }}{{ is_alarm ? ' alarm' : '' }}{{ is_down ? ' sensor-tile-down' : '' }}{{ not sensor.monitoring_enabled ? ' sensor-tile-disabled' : (is_no_data ? ' sensor-tile-no-data' : '') }}" data-sensor-card data-sensor-id="{{ sensor.id }}" data-sensor-has-inputs="{{ sensor.inputs|length ? '1' : '0' }}" data-size="{{ sensor_size }}" draggable="true" title="{{ sensor.name }} · {{ sensor.model ?: '—' }} · {{ sensor.host }}">
        <div class="sensor-tile-actions">
            <button class="icon-button" type="button" aria-label="{{ t('action.resize') }}" title="{{ t('action.resize') }}" data-sensor-resize>{{ icons.icon('maximize', 12) }}</button>
            <button class="icon-button" type="button" aria-label="{{ t('action.edit') }}" title="{{ t('action.edit') }}" data-sensor-edit-open
                data-sensor-id="{{ sensor.id }}" data-sensor-name="{{ sensor.name }}" data-sensor-model="{{ sensor.model }}" data-sensor-icon="{{ sensor.icon ?: 'sensor-server' }}" data-sensor-host="{{ sensor.host }}"
                data-sensor-port="{{ sensor.snmp_port }}" data-sensor-community="{{ sensor.snmp_community }}"
                data-sensor-temperature-oid="{{ sensor.temperature_oid }}" data-sensor-temperature-divisor="{{ sensor.temperature_divisor }}"
                data-sensor-temperature-min="{{ sensor.temperature_min }}" data-sensor-temperature-max="{{ sensor.temperature_max }}"
                data-sensor-humidity-oid="{{ sensor.humidity_oid }}" data-sensor-humidity-divisor="{{ sensor.humidity_divisor }}"
                data-sensor-humidity-min="{{ sensor.humidity_min }}" data-sensor-humidity-max="{{ sensor.humidity_max }}"
                data-sensor-ping-enabled="{{ sensor.ping_enabled ? '1' : '0' }}" data-sensor-monitoring-enabled="{{ sensor.monitoring_enabled ? '1' : '0' }}" data-sensor-notes="{{ sensor.notes }}"
                data-sensor-channels="{{ sensor.channels|json_encode }}">{{ icons.icon('edit', 12) }}</button>
            <button class="icon-button danger" type="button" aria-label="{{ t('action.delete') }}" title="{{ t('action.delete') }}" data-delete-open data-delete-url="/api/v1/sensors/{{ sensor.id }}" data-delete-name="{{ sensor.name }}">{{ icons.icon('trash', 12) }}</button>
        </div>
        <span class="sensor-tile-badge{{ is_down ? ' down' : '' }}" data-sensor-ping-badge>{% if is_down %}{{ t('sensors.ping_down') }}{% elseif sensor.last_ping_ok and sensor.last_ping_latency_ms is not null %}{{ sensor.last_ping_latency_ms|round }}ms{% endif %}</span>
        <div class="sensor-tile-visual">{{ icons.icon(sensor.icon ?: 'sensor-server', 26) }}</div>
        <span class="sensor-tile-status{{ is_down ? ' down' : '' }}" data-sensor-protocol>SNMP</span>
        <strong class="sensor-tile-name">{{ sensor.name }}</strong>
        {% if sensor.inputs|length %}
        <div class="sensor-tile-input-groups" data-sensor-input-groups>
            {% if miasto_inputs|length %}<span class="sensor-tile-input-group{{ miasto_alarm ? ' alarm' : '' }}" data-input-group="miasto">{{ t('sensors.input_group_miasto') }}</span>{% endif %}
            {% if agregat_inputs|length %}<span class="sensor-tile-input-group{{ agregat_alarm ? ' agregat-alarm' : '' }}" data-input-group="agregat">{{ t('sensors.input_group_agregat') }}</span>{% endif %}
        </div>
        {% else %}
        <small class="sensor-tile-values" data-sensor-values><span class="{{ temp_alarm ? 'value-alarm' : '' }}" data-sensor-value-temperature>{{ sensor.last_temperature is not null ? sensor.last_temperature|number_format(1) ~ '°C' : '' }}</span><span class="{{ humidity_alarm ? 'value-alarm' : '' }}" data-sensor-value-humidity>{{ sensor.last_humidity is not null ? sensor.last_humidity|number_format(1) ~ '%' : '' }}</span></small>
        {% if sensor.channels|length %}
        <small class="sensor-tile-channels" data-sensor-channels-values>
            {% for channel in sensor.channels %}
            {% set channel_breach = channel.last_value is not null and ((channel.channel_type == 'temperature' and ((sensor.temperature_min is not null and channel.last_value < sensor.temperature_min) or (sensor.temperature_max is not null and channel.last_value > sensor.temperature_max))) or (channel.channel_type == 'humidity' and ((sensor.humidity_min is not null and channel.last_value < sensor.humidity_min) or (sensor.humidity_max is not null and channel.last_value > sensor.humidity_max)))) %}
            <span class="{{ channel_breach ? 'value-alarm' : '' }}" title="{{ channel.label }}">{{ channel.last_value is not null ? channel.last_value|number_format(1) ~ (channel.channel_type == 'humidity' ? '%' : '°C') : '—' }}</span>
            {% endfor %}
        </small>
        {% endif %}
        {% endif %}
    </article>
    {% else %}
    <div class="empty-state">{{ t('sensors.empty') }}</div>
    {% endfor %}
</section>

<section class="sensor-charts" data-sensor-charts data-sensor-panel="charts" hidden data-vm-unreachable-label="{{ t('sensors.vm_unreachable') }}" data-chart-temperature-label="{{ t('sensors.temperature') }}" data-chart-humidity-label="{{ t('sensors.humidity') }}" data-chart-ping-latency-label="{{ t('sensors.ping_latency') }}" data-chart-power-label="{{ t('sensors.power_status') }}" data-chart-power-ok-label="{{ t('sensors.power_ok') }}" data-chart-power-alarm-label="{{ t('sensors.power_alarm') }}">
    {% if sensors|length %}
    <div class="sensor-charts-controls">
        <label class="field"><span>{{ t('sensors.chart_sensor') }}</span><select data-chart-sensor-select>{% for sensor in sensors %}<option value="{{ sensor.id }}" data-channels="{{ sensor.channels|json_encode }}" data-inputs="{{ sensor.inputs|json_encode }}">{{ sensor.name }}</option>{% endfor %}</select></label>
        <div class="sensor-range-buttons" data-chart-range-buttons>
            <button class="sensor-range-btn" type="button" data-chart-range="5m">5m</button>
            <button class="sensor-range-btn" type="button" data-chart-range="1h">1h</button>
            <button class="sensor-range-btn" type="button" data-chart-range="6h">6h</button>
            <button class="sensor-range-btn active" type="button" data-chart-range="24h">24h</button>
            <button class="sensor-range-btn" type="button" data-chart-range="7d">7d</button>
            <button class="sensor-range-btn" type="button" data-chart-range="30d">30d</button>
        </div>
        <div class="sensor-chart-sensor-actions">
            <button class="button button-ghost button-small" type="button" data-chart-edit-sensor>{{ icons.icon('edit', 14) }}{{ t('action.edit') }}</button>
            <a class="button button-ghost button-small" data-chart-open-sensor href="#" target="_blank" rel="noopener noreferrer">{{ icons.icon('external-link', 14) }}{{ t('sensors.open_device') }}</a>
        </div>
    </div>
    <p class="sensor-chart-warning" data-vm-warning hidden>{{ icons.icon('alert', 15) }}<span>{{ t('sensors.vm_unreachable') }}</span></p>
    <div class="sensor-chart-grid">
        <article class="card sensor-chart-card"><div class="sensor-chart-card-head"><h3>{{ t('sensors.ping_latency') }}</h3><button type="button" class="sensor-chart-reset" data-chart-reset="ping_latency">{{ t('action.reset_zoom') }}</button></div><div class="sensor-chart" data-chart="ping_latency"></div></article>
        <article class="card sensor-chart-card"><div class="sensor-chart-card-head"><h3>{{ t('sensors.power_status') }}</h3><button type="button" class="sensor-chart-reset" data-chart-reset="power">{{ t('action.reset_zoom') }}</button></div><div class="sensor-chart" data-chart="power"></div></article>
        <article class="card sensor-chart-card"><div class="sensor-chart-card-head"><h3>{{ t('sensors.temperature') }}</h3><button type="button" class="sensor-chart-reset" data-chart-reset="temperature">{{ t('action.reset_zoom') }}</button></div><div class="sensor-chart" data-chart="temperature"></div></article>
        <article class="card sensor-chart-card"><div class="sensor-chart-card-head"><h3>{{ t('sensors.humidity') }}</h3><button type="button" class="sensor-chart-reset" data-chart-reset="humidity">{{ t('action.reset_zoom') }}</button></div><div class="sensor-chart" data-chart="humidity"></div></article>
    </div>
    {% else %}
    <div class="empty-state">{{ t('sensors.empty') }}</div>
    {% endif %}
</section>
<script src="/assets/vendor/echarts.min.js?v=20260828a" defer></script>

<section class="sensor-alerts" data-sensor-panel="alerts" hidden>
    <div class="alert-grid">
        <article class="card alert-card">
            <h3>{{ t('alerts.settings_title') }}</h3>
            <form class="alert-inline-form" data-alert-settings-form>
                <label class="field"><span>{{ t('alerts.repeat_interval') }}</span><input name="repeat_interval_minutes" type="number" min="1" value="{{ alert_settings.repeat_interval_minutes }}"></label>
                <button class="button button-primary button-small" type="submit">{{ t('action.save') }}</button>
                <p class="form-error" data-form-error hidden></p>
            </form>
            <small>{{ t('alerts.repeat_interval_hint') }}</small>
            <form class="alert-inline-form" data-alert-test-form>
                <label class="field"><span>{{ t('alerts.test_email') }}</span><input name="email" type="email" placeholder="you@example.com" required></label>
                <button class="button button-ghost button-small" type="submit">{{ t('alerts.send_test') }}</button>
            </form>
            <p class="alert-test-result" data-alert-test-result hidden></p>
        </article>

        <article class="card alert-card">
            <h3>{{ t('alerts.recipients_title') }}</h3>
            <div class="alert-list" data-alert-recipients-list>
                {% for recipient in alert_recipients %}
                <div class="alert-list-row" data-recipient-id="{{ recipient.id }}">
                    <span>{{ recipient.name ? recipient.name ~ ' · ' ~ recipient.email : recipient.email }}</span>
                    <button class="icon-button danger" type="button" aria-label="{{ t('action.delete') }}" data-delete-open data-delete-url="/api/v1/alerts/recipients/{{ recipient.id }}" data-delete-name="{{ recipient.email }}">{{ icons.icon('trash', 12) }}</button>
                </div>
                {% else %}
                <p class="alert-empty">{{ t('alerts.no_recipients') }}</p>
                {% endfor %}
            </div>
            <form class="alert-inline-form" data-alert-recipient-form>
                <input name="email" type="email" placeholder="{{ t('form.email') }}" maxlength="255" required>
                <input name="name" type="text" maxlength="160" placeholder="{{ t('form.name_optional') }}">
                <button class="button button-primary button-small" type="submit">{{ icons.icon('plus', 13) }}{{ t('action.add') }}</button>
                <p class="form-error" data-form-error hidden></p>
            </form>
        </article>

        <article class="card alert-card">
            <h3>{{ t('alerts.groups_title') }}</h3>
            <small>{{ t('alerts.groups_hint') }}</small>
            <div class="alert-groups-list" data-alert-groups-list>
                {% for group in alert_groups %}
                <div class="alert-group-row" data-group-id="{{ group.id }}">
                    <div class="alert-group-head">
                        <strong>{{ group.name }}</strong>
                        <button class="icon-button danger" type="button" aria-label="{{ t('action.delete') }}" data-delete-open data-delete-url="/api/v1/alerts/groups/{{ group.id }}" data-delete-name="{{ group.name }}">{{ icons.icon('trash', 12) }}</button>
                    </div>
                    <div class="alert-group-members">
                        {% for recipient in alert_recipients %}
                        <label class="alert-checkbox"><input type="checkbox" data-group-member-checkbox value="{{ recipient.id }}" {{ recipient.id in group.member_ids ? 'checked' : '' }}><span>{{ recipient.email }}</span></label>
                        {% else %}
                        <span class="alert-empty">{{ t('alerts.no_recipients') }}</span>
                        {% endfor %}
                    </div>
                    <button class="button button-ghost button-small" type="button" data-alert-group-save-members data-id="{{ group.id }}">{{ t('action.save') }}</button>
                </div>
                {% else %}
                <p class="alert-empty">{{ t('alerts.no_groups') }}</p>
                {% endfor %}
            </div>
            <form class="alert-inline-form" data-alert-group-form>
                <input name="name" type="text" maxlength="160" placeholder="{{ t('alerts.group_name') }}" required>
                <button class="button button-primary button-small" type="submit">{{ icons.icon('plus', 13) }}{{ t('action.add') }}</button>
                <p class="form-error" data-form-error hidden></p>
            </form>
        </article>
    </div>

    <article class="card alert-card">
        <h3>{{ t('alerts.sensor_targets_title') }}</h3>
        <div class="alert-sensor-list">
            {% for sensor in sensors %}
            {% set targets = alert_targets[sensor.id] ?? {'recipient_ids': [], 'group_ids': []} %}
            <div class="alert-sensor-row" data-sensor-id="{{ sensor.id }}">
                <span class="alert-sensor-name">{{ sensor.name }}</span>
                <div class="alert-sensor-targets-picker">
                    {% for group in alert_groups %}
                    <label class="alert-checkbox"><input type="checkbox" data-target-group value="{{ group.id }}" {{ group.id in targets.group_ids ? 'checked' : '' }}><span>👥 {{ group.name }}</span></label>
                    {% endfor %}
                    {% for recipient in alert_recipients %}
                    <label class="alert-checkbox"><input type="checkbox" data-target-recipient value="{{ recipient.id }}" {{ recipient.id in targets.recipient_ids ? 'checked' : '' }}><span>{{ recipient.email }}</span></label>
                    {% endfor %}
                    {% if alert_groups|length == 0 and alert_recipients|length == 0 %}
                    <span class="alert-empty">{{ t('alerts.no_recipients') }}</span>
                    {% endif %}
                </div>
                <button class="button button-ghost button-small" type="button" data-alert-sensor-save>{{ t('action.save') }}</button>
            </div>
            {% else %}
            <p class="alert-empty">{{ t('sensors.empty') }}</p>
            {% endfor %}
        </div>
    </article>
</section>

<dialog class="modal entity-modal" id="sensor-modal">
    <form class="modal-card modal-card-wide" data-sensor-form>
        <div class="modal-head"><div><span class="eyebrow">{{ t('action.add_sensor') }}</span><h2>{{ t('modal.sensor_title') }}</h2><p>{{ t('modal.sensor_subtitle') }}</p></div><button class="icon-button" type="button" data-sensor-modal-close aria-label="{{ t('action.close') }}">{{ icons.icon('close') }}</button></div>
        <div class="form-grid">
            <label class="field field-wide"><span>{{ t('form.sensor_name') }}</span><input name="name" maxlength="160" required></label>
            {{ sensor_model_field }}
            <label class="field field-wide"><span>{{ t('form.sensor_icon') }}</span>{% include 'components/sensor-icon-picker.twig' %}</label>
            <label class="field"><span>{{ t('form.sensor_host') }}</span><input name="host" maxlength="255" placeholder="192.168.1.50" required></label>
            <label class="field"><span>{{ t('form.sensor_port') }}</span><input name="snmp_port" type="number" min="1" max="65535" value="161" required></label>
            <label class="field"><span>{{ t('form.sensor_community') }}</span><input name="snmp_community" maxlength="80" value="public" required></label>
            <label class="field"><span>{{ t('form.sensor_temperature_oid') }}</span><input name="temperature_oid" maxlength="255" value="1.3.6.1.4.1.21796.4.1.3.1.4.1" placeholder="1.3.6.1.4.1.21796.4.1.3.1.4.1"><small>{{ t('form.sensor_oid_hint') }}</small></label>
            <label class="field"><span>{{ t('form.sensor_divisor') }}</span><input name="temperature_divisor" type="number" step="0.0001" value="1"></label>
            <label class="field"><span>{{ t('form.sensor_humidity_oid') }}</span><input name="humidity_oid" maxlength="255" value="1.3.6.1.4.1.21796.4.1.3.1.4.2" placeholder="1.3.6.1.4.1.21796.4.1.3.1.4.2"><small>{{ t('form.sensor_oid_hint') }}</small></label>
            <label class="field"><span>{{ t('form.sensor_divisor') }}</span><input name="humidity_divisor" type="number" step="0.0001" value="1"></label>
            {{ sensor_threshold_fields }}
            {{ sensor_channels_field }}
            <label class="field field-wide checkbox-field"><input name="ping_enabled" type="checkbox" value="1" checked><span>{{ t('form.sensor_ping_enabled') }}</span></label>
            <label class="field field-wide checkbox-field"><input name="monitoring_enabled" type="checkbox" value="1" checked><span>{{ t('form.sensor_monitoring_enabled') }}</span></label>
            <label class="field field-wide"><span>{{ t('form.notes') }}</span><textarea name="notes" maxlength="2000" rows="3"></textarea></label>
        </div>
        <div class="form-note">{{ icons.icon('info', 16) }}<span>{{ t('form.sensor_oid_note') }}</span></div>
        <p class="form-error" data-form-error hidden></p>
        <div class="modal-actions"><button class="button button-ghost" type="button" data-sensor-modal-close>{{ t('action.cancel') }}</button><button class="button button-primary" type="submit">{{ icons.icon('plus') }}{{ t('action.create_sensor') }}</button></div>
    </form>
</dialog>

<dialog class="modal entity-modal" id="sensor-edit-modal">
    <form class="modal-card modal-card-wide" data-sensor-edit-form>
        <input type="hidden" name="sensor_id">
        <div class="modal-head"><div><span class="eyebrow">{{ t('action.edit') }}</span><h2>{{ t('modal.sensor_edit_title') }}</h2></div><button class="icon-button" type="button" data-sensor-edit-close aria-label="{{ t('action.close') }}">{{ icons.icon('close') }}</button></div>
        <div class="form-grid">
            <label class="field field-wide"><span>{{ t('form.sensor_name') }}</span><input name="name" maxlength="160" required></label>
            {{ sensor_model_field }}
            <label class="field field-wide"><span>{{ t('form.sensor_icon') }}</span>{% include 'components/sensor-icon-picker.twig' %}</label>
            <label class="field"><span>{{ t('form.sensor_host') }}</span><input name="host" maxlength="255" required></label>
            <label class="field"><span>{{ t('form.sensor_port') }}</span><input name="snmp_port" type="number" min="1" max="65535" required></label>
            <label class="field"><span>{{ t('form.sensor_community') }}</span><input name="snmp_community" maxlength="80" required></label>
            <label class="field"><span>{{ t('form.sensor_temperature_oid') }}</span><input name="temperature_oid" maxlength="255"><small>{{ t('form.sensor_oid_hint') }}</small></label>
            <label class="field"><span>{{ t('form.sensor_divisor') }}</span><input name="temperature_divisor" type="number" step="0.0001"></label>
            <label class="field"><span>{{ t('form.sensor_humidity_oid') }}</span><input name="humidity_oid" maxlength="255"><small>{{ t('form.sensor_oid_hint') }}</small></label>
            <label class="field"><span>{{ t('form.sensor_divisor') }}</span><input name="humidity_divisor" type="number" step="0.0001"></label>
            {{ sensor_threshold_fields }}
            {{ sensor_channels_field }}
            <label class="field field-wide checkbox-field"><input name="ping_enabled" type="checkbox" value="1"><span>{{ t('form.sensor_ping_enabled') }}</span></label>
            <label class="field field-wide checkbox-field"><input name="monitoring_enabled" type="checkbox" value="1"><span>{{ t('form.sensor_monitoring_enabled') }}</span></label>
            <label class="field field-wide"><span>{{ t('form.notes') }}</span><textarea name="notes" maxlength="2000" rows="3"></textarea></label>
        </div>
        <p class="form-error" data-form-error hidden></p>
        <div class="modal-actions"><button class="button button-ghost" type="button" data-sensor-edit-close>{{ t('action.cancel') }}</button><button class="button button-primary" type="submit">{{ icons.icon('save') }}{{ t('action.save') }}</button></div>
    </form>
</dialog>

<dialog class="modal entity-modal" id="sensor-inputs-modal" data-input-ok-label="{{ t('sensors.input_ok') }}" data-input-alarm-label="{{ t('sensors.input_alarm') }}" data-input-unknown-label="{{ t('sensors.input_unknown') }}">
    <div class="modal-card">
        <div class="modal-head"><div><span class="eyebrow">{{ t('modal.sensor_inputs_title') }}</span><h2 data-sensor-inputs-name></h2></div><button class="icon-button" type="button" data-sensor-inputs-close aria-label="{{ t('action.close') }}">{{ icons.icon('close') }}</button></div>
        <div class="sensor-inputs-table" data-sensor-inputs-body></div>
    </div>
</dialog>
{% endblock %}
