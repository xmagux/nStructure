{% extends 'layouts/app.twig' %}
{% import 'components/icons.twig' as icons %}

{% block content %}
{% set sensor_model_field %}
<input type="hidden" name="model">
<label class="field"><span>{{ t('form.sensor_model') }}</span><select data-sensor-model-select>
    <option value="HWG_STE">HWg-STE</option>
    <option value="STE2_LITE">STE2 Lite</option>
    <option value="OTHER">{{ t('sensors.other_model') }}</option>
</select></label>
<label class="field" data-sensor-model-custom-field hidden><span>{{ t('form.sensor_model_custom') }}</span><input type="text" maxlength="80" data-sensor-model-custom placeholder="HWg-PWR, Poseidon2…"></label>
{% endset %}
{% set sensor_threshold_fields %}
<label class="field"><span>{{ t('form.sensor_temperature_min') }}</span><input name="temperature_min" type="number" step="0.01" placeholder="{{ t('form.sensor_no_limit') }}"></label>
<label class="field"><span>{{ t('form.sensor_temperature_max') }}</span><input name="temperature_max" type="number" step="0.01" placeholder="{{ t('form.sensor_no_limit') }}"></label>
<label class="field"><span>{{ t('form.sensor_humidity_min') }}</span><input name="humidity_min" type="number" step="0.01" placeholder="{{ t('form.sensor_no_limit') }}"></label>
<label class="field"><span>{{ t('form.sensor_humidity_max') }}</span><input name="humidity_max" type="number" step="0.01" placeholder="{{ t('form.sensor_no_limit') }}"></label>
{% endset %}
<section class="page-hero compact-hero">
    <div><span class="eyebrow">{{ t('sensors.eyebrow') }}</span><h1>{{ t('sensors.title') }}</h1><p>{{ t('sensors.subtitle') }}</p></div>
    <div class="hero-actions"><button class="button button-ghost" type="button" data-sensors-refresh>{{ icons.icon('refresh-cw') }}{{ t('action.refresh') }}</button><button class="button button-primary" type="button" data-sensor-modal-open>{{ icons.icon('plus') }}{{ t('action.add_sensor') }}</button></div>
</section>

<div class="sensor-tabs" data-sensor-tabs>
    <button class="sensor-tab active" type="button" data-sensor-tab="list">{{ icons.icon('layers', 15) }}{{ t('sensors.tab_list') }}</button>
    <button class="sensor-tab" type="button" data-sensor-tab="charts">{{ icons.icon('activity', 15) }}{{ t('sensors.tab_charts') }}</button>
</div>

<section class="sensor-grid" data-sensor-grid data-sensor-panel="list" data-ping-up-label="{{ t('sensors.ping_up') }}" data-ping-down-label="{{ t('sensors.ping_down') }}" data-not-configured-label="{{ t('sensors.not_configured') }}" data-alarm-ping-label="{{ t('sensors.alarm_ping') }}" data-alarm-temperature-label="{{ t('sensors.alarm_temperature') }}" data-alarm-humidity-label="{{ t('sensors.alarm_humidity') }}" data-ok-label="{{ t('sensors.ok') }}">
    {% for sensor in sensors %}
    <article class="card sensor-card" data-sensor-card data-sensor-id="{{ sensor.id }}">
        <div class="sensor-card-head">
            <div><strong>{{ sensor.name }}</strong><small>{{ sensor.model ?: '—' }} · {{ sensor.host }}</small></div>
            <span class="sensor-ping-badge" data-sensor-ping>{{ icons.icon('activity', 13) }}<span data-sensor-ping-text>{{ t('sensors.pending') }}</span></span>
        </div>
        <div class="sensor-readings">
            <div class="sensor-reading" data-sensor-temperature>
                <span class="sensor-reading-icon">{{ icons.icon('thermometer', 18) }}</span>
                <div><span class="sensor-reading-label">{{ t('sensors.temperature') }}</span><strong data-sensor-reading-value>{{ t('sensors.pending') }}</strong></div>
            </div>
            <div class="sensor-reading" data-sensor-humidity>
                <span class="sensor-reading-icon">{{ icons.icon('droplets', 18) }}</span>
                <div><span class="sensor-reading-label">{{ t('sensors.humidity') }}</span><strong data-sensor-reading-value>{{ t('sensors.pending') }}</strong></div>
            </div>
        </div>
        <div class="sensor-card-actions">
            <button class="icon-button" type="button" aria-label="{{ t('action.edit') }}" title="{{ t('action.edit') }}" data-sensor-edit-open
                data-sensor-id="{{ sensor.id }}" data-sensor-name="{{ sensor.name }}" data-sensor-model="{{ sensor.model }}" data-sensor-host="{{ sensor.host }}"
                data-sensor-port="{{ sensor.snmp_port }}" data-sensor-community="{{ sensor.snmp_community }}"
                data-sensor-temperature-oid="{{ sensor.temperature_oid }}" data-sensor-temperature-divisor="{{ sensor.temperature_divisor }}"
                data-sensor-temperature-min="{{ sensor.temperature_min }}" data-sensor-temperature-max="{{ sensor.temperature_max }}"
                data-sensor-humidity-oid="{{ sensor.humidity_oid }}" data-sensor-humidity-divisor="{{ sensor.humidity_divisor }}"
                data-sensor-humidity-min="{{ sensor.humidity_min }}" data-sensor-humidity-max="{{ sensor.humidity_max }}"
                data-sensor-ping-enabled="{{ sensor.ping_enabled ? '1' : '0' }}" data-sensor-notes="{{ sensor.notes }}">{{ icons.icon('edit', 15) }}</button>
            <button class="icon-button danger" type="button" aria-label="{{ t('action.delete') }}" title="{{ t('action.delete') }}" data-delete-open data-delete-url="/api/v1/sensors/{{ sensor.id }}" data-delete-name="{{ sensor.name }}">{{ icons.icon('trash', 15) }}</button>
        </div>
    </article>
    {% else %}
    <div class="empty-state">{{ t('sensors.empty') }}</div>
    {% endfor %}
</section>

<section class="sensor-charts" data-sensor-charts data-sensor-panel="charts" hidden data-vm-unreachable-label="{{ t('sensors.vm_unreachable') }}" data-chart-temperature-label="{{ t('sensors.temperature') }}" data-chart-humidity-label="{{ t('sensors.humidity') }}" data-chart-ping-latency-label="{{ t('sensors.ping_latency') }}">
    {% if sensors|length %}
    <div class="sensor-charts-controls">
        <label class="field"><span>{{ t('sensors.chart_sensor') }}</span><select data-chart-sensor-select>{% for sensor in sensors %}<option value="{{ sensor.id }}">{{ sensor.name }}</option>{% endfor %}</select></label>
        <div class="sensor-range-buttons" data-chart-range-buttons>
            <button class="sensor-range-btn" type="button" data-chart-range="5m">5m</button>
            <button class="sensor-range-btn" type="button" data-chart-range="1h">1h</button>
            <button class="sensor-range-btn" type="button" data-chart-range="6h">6h</button>
            <button class="sensor-range-btn active" type="button" data-chart-range="24h">24h</button>
            <button class="sensor-range-btn" type="button" data-chart-range="7d">7d</button>
            <button class="sensor-range-btn" type="button" data-chart-range="30d">30d</button>
        </div>
    </div>
    <p class="sensor-chart-warning" data-vm-warning hidden>{{ icons.icon('alert', 15) }}<span>{{ t('sensors.vm_unreachable') }}</span></p>
    <div class="sensor-chart-grid">
        <article class="card sensor-chart-card"><h3>{{ t('sensors.temperature') }}</h3><div class="sensor-chart" data-chart="temperature"></div></article>
        <article class="card sensor-chart-card"><h3>{{ t('sensors.humidity') }}</h3><div class="sensor-chart" data-chart="humidity"></div></article>
        <article class="card sensor-chart-card"><h3>{{ t('sensors.ping_latency') }}</h3><div class="sensor-chart" data-chart="ping_latency"></div></article>
    </div>
    {% else %}
    <div class="empty-state">{{ t('sensors.empty') }}</div>
    {% endif %}
</section>
<script src="/assets/vendor/echarts.min.js?v=20260828a" defer></script>

<dialog class="modal entity-modal" id="sensor-modal">
    <form class="modal-card modal-card-wide" data-sensor-form>
        <div class="modal-head"><div><span class="eyebrow">{{ t('action.add_sensor') }}</span><h2>{{ t('modal.sensor_title') }}</h2><p>{{ t('modal.sensor_subtitle') }}</p></div><button class="icon-button" type="button" data-sensor-modal-close aria-label="{{ t('action.close') }}">{{ icons.icon('close') }}</button></div>
        <div class="form-grid">
            <label class="field field-wide"><span>{{ t('form.sensor_name') }}</span><input name="name" maxlength="160" required></label>
            {{ sensor_model_field }}
            <label class="field"><span>{{ t('form.sensor_host') }}</span><input name="host" maxlength="255" placeholder="192.168.1.50" required></label>
            <label class="field"><span>{{ t('form.sensor_port') }}</span><input name="snmp_port" type="number" min="1" max="65535" value="161" required></label>
            <label class="field"><span>{{ t('form.sensor_community') }}</span><input name="snmp_community" maxlength="80" value="public" required></label>
            <label class="field"><span>{{ t('form.sensor_temperature_oid') }}</span><input name="temperature_oid" maxlength="255" value="1.3.6.1.4.1.21796.4.1.3.1.4.1" placeholder="1.3.6.1.4.1.21796.4.1.3.1.4.1"><small>{{ t('form.sensor_oid_hint') }}</small></label>
            <label class="field"><span>{{ t('form.sensor_divisor') }}</span><input name="temperature_divisor" type="number" step="0.0001" value="1"></label>
            <label class="field"><span>{{ t('form.sensor_humidity_oid') }}</span><input name="humidity_oid" maxlength="255" value="1.3.6.1.4.1.21796.4.1.3.1.4.2" placeholder="1.3.6.1.4.1.21796.4.1.3.1.4.2"><small>{{ t('form.sensor_oid_hint') }}</small></label>
            <label class="field"><span>{{ t('form.sensor_divisor') }}</span><input name="humidity_divisor" type="number" step="0.0001" value="1"></label>
            {{ sensor_threshold_fields }}
            <label class="field field-wide checkbox-field"><input name="ping_enabled" type="checkbox" value="1" checked><span>{{ t('form.sensor_ping_enabled') }}</span></label>
            <label class="field field-wide"><span>{{ t('form.notes') }}</span><textarea name="notes" maxlength="2000" rows="3"></textarea></label>
        </div>
        <div class="form-note">{{ icons.icon('info', 16) }}<span>{{ t('form.sensor_oid_note') }}</span></div>
        <p class="form-error" data-form-error hidden></p>
        <div class="modal-actions"><button class="button button-ghost" type="button" data-sensor-modal-close>{{ t('action.cancel') }}</button><button class="button button-primary" type="submit">{{ icons.icon('plus') }}{{ t('action.create_sensor') }}</button></div>
    </form>
</dialog>

<dialog class="modal entity-modal" id="sensor-edit-modal">
    <form class="modal-card modal-card-wide" data-sensor-edit-form>
        <input type="hidden" name="sensor_id">
        <div class="modal-head"><div><span class="eyebrow">{{ t('action.edit') }}</span><h2>{{ t('modal.sensor_edit_title') }}</h2></div><button class="icon-button" type="button" data-sensor-edit-close aria-label="{{ t('action.close') }}">{{ icons.icon('close') }}</button></div>
        <div class="form-grid">
            <label class="field field-wide"><span>{{ t('form.sensor_name') }}</span><input name="name" maxlength="160" required></label>
            {{ sensor_model_field }}
            <label class="field"><span>{{ t('form.sensor_host') }}</span><input name="host" maxlength="255" required></label>
            <label class="field"><span>{{ t('form.sensor_port') }}</span><input name="snmp_port" type="number" min="1" max="65535" required></label>
            <label class="field"><span>{{ t('form.sensor_community') }}</span><input name="snmp_community" maxlength="80" required></label>
            <label class="field"><span>{{ t('form.sensor_temperature_oid') }}</span><input name="temperature_oid" maxlength="255"><small>{{ t('form.sensor_oid_hint') }}</small></label>
            <label class="field"><span>{{ t('form.sensor_divisor') }}</span><input name="temperature_divisor" type="number" step="0.0001"></label>
            <label class="field"><span>{{ t('form.sensor_humidity_oid') }}</span><input name="humidity_oid" maxlength="255"><small>{{ t('form.sensor_oid_hint') }}</small></label>
            <label class="field"><span>{{ t('form.sensor_divisor') }}</span><input name="humidity_divisor" type="number" step="0.0001"></label>
            {{ sensor_threshold_fields }}
            <label class="field field-wide checkbox-field"><input name="ping_enabled" type="checkbox" value="1"><span>{{ t('form.sensor_ping_enabled') }}</span></label>
            <label class="field field-wide"><span>{{ t('form.notes') }}</span><textarea name="notes" maxlength="2000" rows="3"></textarea></label>
        </div>
        <p class="form-error" data-form-error hidden></p>
        <div class="modal-actions"><button class="button button-ghost" type="button" data-sensor-edit-close>{{ t('action.cancel') }}</button><button class="button button-primary" type="submit">{{ icons.icon('save') }}{{ t('action.save') }}</button></div>
    </form>
</dialog>
{% endblock %}
