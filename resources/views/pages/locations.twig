{% extends 'layouts/app.twig' %}
{% import 'components/icons.twig' as icons %}

{% block content %}
<section class="page-hero compact-hero">
    <div><span class="eyebrow">{{ t('locations.eyebrow') }}</span><h1>{{ t('locations.title') }}</h1><p>{{ t('locations.subtitle') }}</p></div>
    <div class="hero-search-group"><label class="inline-search hero-search">{{ icons.icon('search') }}<input type="search" placeholder="{{ t('action.search') }}" data-list-search></label><span class="result-count">{{ locations|length }} {{ t('nav.locations')|lower }}</span></div>
    <div class="hero-actions"><button class="button button-ghost" type="button">{{ icons.icon('filter') }}{{ t('action.filter') }}</button><button class="button button-primary" type="button" data-location-modal-open>{{ icons.icon('plus') }}{{ t('action.add_location') }}</button></div>
</section>

<section class="locations-grid" data-search-list>
    {% for location in locations %}
    <a class="location-tile tone-{{ location.accent }}" href="/locations/{{ location.id }}" data-search-item="{{ (location.code ~ ' ' ~ location.name ~ ' ' ~ location.address)|lower }}">
        <div class="tile-head"><span class="location-symbol large">{{ icons.icon(location.icon_key, 25) }}</span><span class="status-badge status-{{ location.status }}" title="{{ t('common.' ~ location.status) }}"><i></i>{% if location.status != 'healthy' %}{{ t('common.' ~ location.status) }}{% endif %}</span></div>
        <div class="tile-body"><span class="code-label">{{ location.code }}</span><h2>{{ location.name }}</h2><p>{{ location.address ?: '—' }}</p></div>
        <div class="tile-stats"><div><strong>{{ location.rooms }}</strong><span>{{ t('common.rooms') }}</span></div><div><strong>{{ location.racks }}</strong><span>{{ t('common.racks') }}</span></div><div><strong>{{ location.panels }}</strong><span>{{ t('common.panels') }}</span></div><div><strong>{{ location.fibers }}J</strong><span>{{ t('common.capacity') }}</span></div></div>
        <div class="tile-progress"><div><span>{{ t('common.utilization') }}</span><strong>{{ location.utilization }}%</strong></div><div class="progress"><i style="width: {{ location.utilization }}%"></i></div></div>
        <span class="tile-action"><span>{{ t('action.open') }}</span>{{ icons.icon('arrow', 17) }}</span>
    </a>
    {% else %}<div class="empty-state"><h2>{{ t('locations.empty') }}</h2></div>{% endfor %}
</section>
{% endblock %}
