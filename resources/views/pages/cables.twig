{% extends 'layouts/app.twig' %}
{% import 'components/icons.twig' as icons %}

{% block content %}
<section class="page-hero compact-hero">
    <div><span class="eyebrow">{{ t('cables.eyebrow') }}</span><h1>{{ t('cables.title') }}</h1><p>{{ t('cables.subtitle') }}</p></div>
    <div class="hero-search-group"><label class="inline-search hero-search">{{ icons.icon('search') }}<input type="search" placeholder="{{ t('action.search') }}" data-list-search></label><span class="result-count">{{ cables|length }} {{ t('nav.cables')|lower }}</span></div>
    <div class="hero-actions"><button class="button button-ghost" type="button">{{ icons.icon('filter') }}{{ t('action.filter') }}</button><button class="button button-primary" type="button" data-cable-modal-open>{{ icons.icon('plus') }}{{ t('action.add_cable') }}</button></div>
</section>

<section class="cable-list" data-search-list>
    {% for cable in cables %}
    <article class="cable-card" data-search-item="{{ (cable.code ~ ' ' ~ cable.name ~ ' ' ~ cable.source ~ ' ' ~ cable.destinations|join(' '))|lower }}">
        <div class="cable-accent {{ cable.accent }}"></div>
        <div class="cable-main"><span class="cable-icon tone-{{ cable.accent }}">{{ icons.icon('cable', 25) }}</span><div><span class="code-label">{{ cable.code }}</span><h2>{{ cable.name }}</h2><p class="cable-route"><strong>{{ cable.source }}</strong><span>→</span><strong>{{ cable.destinations|join(' · ') }}</strong></p></div></div>
        <div class="cable-capacity"><div><span>{{ t('common.capacity') }}</span><strong>{{ cable.used }}/{{ cable.fiber_count }}J</strong></div><div class="progress"><i style="width: {{ (cable.used / cable.fiber_count * 100)|round }}%"></i></div><small>{{ (cable.used / cable.fiber_count * 100)|round }}% {{ t('common.utilization')|lower }}</small></div>
        <div class="cable-meta"><span><small>{{ t('common.medium') }}</small><strong class="medium-chip">{{ cable.medium }}</strong></span><span><small>{{ t('common.length') }}</small><strong>{{ cable.length }}</strong></span><span><small>{{ t('common.segments') }}</small><strong>{{ cable.segments }}</strong></span><span><small>{{ t('common.status') }}</small><strong class="status-badge status-{{ cable.status }}"><i></i>{{ t('common.' ~ cable.status) }}</strong></span></div>
        <div class="cable-actions"><button class="row-action large" type="button" aria-label="{{ t('action.edit') }}" data-cable-edit-open data-cable-id="{{ cable.id }}" data-code="{{ cable.code }}" data-name="{{ cable.name }}" data-medium="{{ cable.medium }}" data-fiber-count="{{ cable.fiber_count }}" data-source-endpoint="{{ cable.source_endpoint_key }}" data-destination-endpoint="{{ cable.destination_endpoint_key }}" data-length-m="{{ cable.length_m }}" data-operational-status="{{ cable.operational_status }}">{{ icons.icon('edit', 18) }}</button><button class="row-action large danger" type="button" aria-label="{{ t('action.delete') }}" data-delete-open data-delete-url="/api/v1/cables/{{ cable.id }}" data-delete-name="{{ cable.code }} · {{ cable.name }}">{{ icons.icon('trash', 18) }}</button></div>
        {% include 'components/asset-gallery.twig' with {
            images: cable.images,
            upload_url: '/api/v1/cables/' ~ cable.id ~ '/images',
            input_id: 'cable-image-upload-' ~ cable.id,
            entity_code: cable.code,
            title: t('photos.cable_title'),
            subtitle: t('photos.cable_subtitle')
        } %}
    </article>
    {% endfor %}
</section>

<dialog class="modal entity-modal" id="cable-modal">
    <form class="modal-card modal-card-wide" data-cable-form>
        <div class="modal-head"><div><span class="eyebrow">{{ t('action.add_cable') }}</span><h2>{{ t('modal.cable_title') }}</h2><p>{{ t('modal.cable_subtitle') }}</p></div><button class="icon-button" type="button" data-cable-modal-close aria-label="{{ t('action.close') }}">{{ icons.icon('close') }}</button></div>
        <div class="form-grid"><label class="field"><span>{{ t('form.cable_code') }}</span><input name="code" maxlength="60" placeholder="CBL-WAW-001" required></label><label class="field"><span>{{ t('form.cable_name') }}</span><input name="name" maxlength="160" placeholder="{{ t('form.cable_name_hint') }}" required></label><label class="field"><span>{{ t('form.medium') }}</span><select name="medium" required><option value="SM">SM</option><option value="MM">MM</option></select></label><label class="field"><span>{{ t('form.fiber_count') }}</span><input name="fiber_count" type="number" min="1" max="1728" value="24" required></label><label class="field"><span>{{ t('form.source_endpoint') }}</span><select name="source_endpoint" required><optgroup label="{{ t('form.endpoint_locations') }}">{% for endpoint in cable_endpoint_options.locations %}<option value="{{ endpoint.key }}">{{ endpoint.label }}</option>{% endfor %}</optgroup><optgroup label="{{ t('form.endpoint_rooms') }}">{% for endpoint in cable_endpoint_options.rooms %}<option value="{{ endpoint.key }}">{{ endpoint.label }}</option>{% endfor %}</optgroup><optgroup label="{{ t('form.endpoint_racks') }}">{% for endpoint in cable_endpoint_options.racks %}<option value="{{ endpoint.key }}">{{ endpoint.label }}</option>{% endfor %}</optgroup></select><small>{{ t('form.endpoint_hint') }}</small></label><label class="field"><span>{{ t('form.destination_endpoint') }}</span><select name="destination_endpoint" required><optgroup label="{{ t('form.endpoint_locations') }}">{% for endpoint in cable_endpoint_options.locations %}<option value="{{ endpoint.key }}" {{ loop.index == 2 ? 'selected' : '' }}>{{ endpoint.label }}</option>{% endfor %}</optgroup><optgroup label="{{ t('form.endpoint_rooms') }}">{% for endpoint in cable_endpoint_options.rooms %}<option value="{{ endpoint.key }}">{{ endpoint.label }}</option>{% endfor %}</optgroup><optgroup label="{{ t('form.endpoint_racks') }}">{% for endpoint in cable_endpoint_options.racks %}<option value="{{ endpoint.key }}">{{ endpoint.label }}</option>{% endfor %}</optgroup></select><small>{{ t('form.endpoint_hint') }}</small></label><label class="field"><span>{{ t('form.length_m') }}</span><input name="length_m" type="number" min="0" step="0.01" value="0" required></label><label class="field"><span>{{ t('common.status') }}</span><select name="operational_status"><option value="PLANNED">{{ t('common.planned') }}</option><option value="ACTIVE">{{ t('common.active') }}</option><option value="MAINTENANCE">{{ t('common.maintenance') }}</option></select></label></div>
        <p class="form-error" data-form-error hidden></p>
        <div class="modal-actions"><button class="button button-ghost" type="button" data-cable-modal-close>{{ t('action.cancel') }}</button><button class="button button-primary" type="submit">{{ icons.icon('plus') }}{{ t('action.create_cable') }}</button></div>
    </form>
</dialog>

<dialog class="modal entity-modal" id="cable-edit-modal">
    <form class="modal-card modal-card-wide" data-cable-edit-form>
        <input type="hidden" name="cable_id" data-cable-edit-id>
        <div class="modal-head"><div><span class="eyebrow">{{ t('action.edit_cable') }}</span><h2>{{ t('modal.cable_edit_title') }}</h2><p data-cable-edit-context></p></div><button class="icon-button" type="button" data-cable-edit-close aria-label="{{ t('action.close') }}">{{ icons.icon('close') }}</button></div>
        <div class="form-grid"><label class="field"><span>{{ t('form.cable_code') }}</span><input name="code" maxlength="60" required></label><label class="field"><span>{{ t('form.cable_name') }}</span><input name="name" maxlength="160" required></label><label class="field"><span>{{ t('form.medium') }}</span><select name="medium" required><option value="SM">SM</option><option value="MM">MM</option></select></label><label class="field"><span>{{ t('form.fiber_count') }}</span><input name="fiber_count" type="number" min="1" max="1728" required></label><label class="field"><span>{{ t('form.source_endpoint') }}</span><select name="source_endpoint" required><optgroup label="{{ t('form.endpoint_locations') }}">{% for endpoint in cable_endpoint_options.locations %}<option value="{{ endpoint.key }}">{{ endpoint.label }}</option>{% endfor %}</optgroup><optgroup label="{{ t('form.endpoint_rooms') }}">{% for endpoint in cable_endpoint_options.rooms %}<option value="{{ endpoint.key }}">{{ endpoint.label }}</option>{% endfor %}</optgroup><optgroup label="{{ t('form.endpoint_racks') }}">{% for endpoint in cable_endpoint_options.racks %}<option value="{{ endpoint.key }}">{{ endpoint.label }}</option>{% endfor %}</optgroup></select><small>{{ t('form.endpoint_hint') }}</small></label><label class="field"><span>{{ t('form.destination_endpoint') }}</span><select name="destination_endpoint" required><optgroup label="{{ t('form.endpoint_locations') }}">{% for endpoint in cable_endpoint_options.locations %}<option value="{{ endpoint.key }}">{{ endpoint.label }}</option>{% endfor %}</optgroup><optgroup label="{{ t('form.endpoint_rooms') }}">{% for endpoint in cable_endpoint_options.rooms %}<option value="{{ endpoint.key }}">{{ endpoint.label }}</option>{% endfor %}</optgroup><optgroup label="{{ t('form.endpoint_racks') }}">{% for endpoint in cable_endpoint_options.racks %}<option value="{{ endpoint.key }}">{{ endpoint.label }}</option>{% endfor %}</optgroup></select><small>{{ t('form.endpoint_hint') }}</small></label><label class="field"><span>{{ t('form.length_m') }}</span><input name="length_m" type="number" min="0" step="0.01" required></label><label class="field"><span>{{ t('common.status') }}</span><select name="operational_status"><option value="PLANNED">{{ t('common.planned') }}</option><option value="ACTIVE">{{ t('common.active') }}</option><option value="MAINTENANCE">{{ t('common.maintenance') }}</option><option value="DAMAGED">{{ t('common.damaged') }}</option><option value="RETIRED">{{ t('common.retired') }}</option></select></label></div>
        <div class="form-note">{{ icons.icon('info', 16) }}<span>{{ t('form.cable_resize_hint') }}</span></div>
        <p class="form-error" data-form-error hidden></p><div class="modal-actions"><button class="button button-ghost" type="button" data-cable-edit-close>{{ t('action.cancel') }}</button><button class="button button-primary" type="submit">{{ icons.icon('save') }}{{ t('action.save') }}</button></div>
    </form>
</dialog>
{% endblock %}
