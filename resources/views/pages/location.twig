{% extends 'layouts/app.twig' %}
{% import 'components/icons.twig' as icons %}

{% block content %}
<nav class="breadcrumbs"><a href="/locations">{{ t('nav.locations') }}</a><span>›</span><strong>{{ location.code }}</strong></nav>
<section class="asset-hero tone-{{ location.accent }}">
    <div class="asset-title"><span class="location-symbol xl">{{ icons.icon(location.icon_key, 30) }}</span><div><span class="code-label">{{ location.code }}</span><h1>{{ location.name }}</h1><p>{{ location.address }}</p></div></div>
    <div class="asset-hero-actions"><span class="status-badge status-{{ location.status }}" title="{{ t('common.' ~ location.status) }}"><i></i>{% if location.status != 'healthy' %}{{ t('common.' ~ location.status) }}{% endif %}</span><button class="button button-quiet button-small" type="button" data-location-edit-open>{{ icons.icon('edit', 15) }}{{ t('action.edit') }}</button><div class="entity-menu hs-dropdown"><button class="icon-button hs-dropdown-toggle" type="button" aria-label="{{ t('action.more_options') }}" title="{{ t('action.more_options') }}">{{ icons.icon('more', 16) }}</button><div class="hs-dropdown-menu entity-menu-panel hidden" role="menu"><button class="entity-menu-item danger" type="button" data-delete-open data-delete-url="/api/v1/locations/{{ location.id }}" data-delete-name="{{ location.code }} · {{ location.name }}" data-delete-redirect="/locations">{{ icons.icon('trash', 14) }}{{ t('action.delete') }}</button></div></div></div>
    <div class="asset-glow"></div>
</section>

<section class="section-block">
    <div class="section-heading"><div><h2>{{ t('location.server_rooms') }}</h2><p>{{ location.rooms }} {{ t('common.rooms') }} · {{ location.racks }} {{ t('common.racks') }} · {{ location.panels }} {{ t('common.panels') }} · {{ location.fibers }}J {{ t('common.capacity')|lower }} · {{ location.utilization }}% {{ t('common.utilization')|lower }}</p></div>{% if location.rooms_detail|length > 1 %}<label class="inline-search">{{ icons.icon('search') }}<input type="search" placeholder="{{ t('location.search_rooms') }}" data-list-search></label>{% endif %}<button class="button button-ghost" type="button" data-room-modal-open>{{ icons.icon('plus') }}{{ t('action.add_room') }}</button></div>
    <div class="room-list" data-search-list>
        {% for room in location.rooms_detail %}
        <article class="room-card" data-search-item="{{ (room.code ~ ' ' ~ room.name)|lower }}">
            <div class="room-head"><span class="room-icon">{{ icons.icon('room', 22) }}</span><div><span class="code-label">{{ room.code }}</span><h3>{{ room.name }}</h3></div><span class="status-badge status-healthy" title="{{ t('common.online') }}"><i></i></span></div>
            <div class="room-action-strip"><button class="button button-quiet button-small" type="button" data-room-edit-open data-room-id="{{ room.id }}" data-room-name="{{ room.name }}" data-room-floor="{{ room.floor }}" data-room-sensor-id="{{ room.sensor_id }}" data-location-id="{{ location.id }}">{{ icons.icon('edit', 15) }}<span>{{ t('action.edit') }}</span></button><button class="button button-quiet button-small" type="button" data-rack-modal-open data-room-id="{{ room.id }}" data-room-name="{{ room.name }}" data-room-sensor-id="{{ room.sensor_id }}">{{ icons.icon('plus', 15) }}<span>{{ t('action.add_rack') }}</span></button><button class="button button-quiet button-small" type="button" data-ups-modal-open data-room-id="{{ room.id }}" data-room-name="{{ room.name }}">{{ icons.icon('ups', 15) }}<span>{{ t('action.add_ups') }}</span></button><div class="entity-menu hs-dropdown"><button class="icon-button hs-dropdown-toggle" type="button" aria-label="{{ t('action.more_options') }}" title="{{ t('action.more_options') }}">{{ icons.icon('more', 16) }}</button><div class="hs-dropdown-menu entity-menu-panel hidden" role="menu"><button class="entity-menu-item danger" type="button" data-delete-open data-delete-url="/api/v1/server-rooms/{{ room.id }}" data-delete-name="{{ room.code }} · {{ room.name }}">{{ icons.icon('trash', 14) }}{{ t('action.delete') }}</button></div></div></div>
            <div class="room-meta"><span>{{ t('location.floor') }} <strong>{{ room.floor ?: '—' }}</strong></span>{% if room.sensor_id %}<a class="room-meta-link" href="/tools/sensors?sensor={{ room.sensor_id }}" title="{{ t('location.view_chart') }}">{{ t('location.temperature') }} <strong>{{ room.temperature }}</strong></a><a class="room-meta-link" href="/tools/sensors?sensor={{ room.sensor_id }}" title="{{ t('location.view_chart') }}">{{ t('location.humidity') }} <strong>{{ room.humidity }}</strong></a>{% else %}<span>{{ t('location.temperature') }} <strong>{{ room.temperature }}</strong></span><span>{{ t('location.humidity') }} <strong>{{ room.humidity }}</strong></span>{% endif %}</div>
            <div class="ups-section">
                <div class="room-subheading"><span>{{ icons.icon('ups', 16) }}{{ t('ups.title') }}</span><small>{{ room.ups_devices|length }}</small></div>
                <div class="ups-list">
                    {% for ups in room.ups_devices %}
                    {% set ups_status_class = ups.operational_status == 'active' ? 'healthy' : (ups.operational_status == 'alarm' ? 'damaged' : (ups.operational_status == 'maintenance' ? 'attention' : 'retired')) %}
                    <article class="ups-card battery-{{ ups.battery_state }}">
                        <div class="ups-icon">{{ icons.icon('ups', 20) }}</div>
                        <div class="ups-copy"><div class="ups-title-row"><div><span class="code-label">{{ ups.code }}</span><strong>{{ ups.name }}</strong></div><span class="status-badge status-{{ ups_status_class }}" title="{{ t('ups.status_' ~ ups.operational_status) }}"><i></i>{% if ups.operational_status != 'active' %}{{ t('ups.status_' ~ ups.operational_status) }}{% endif %}</span></div><p>{{ [ups.manufacturer, ups.model]|filter(value => value)|join(' · ') ?: t('ups.model_unknown') }}</p><div class="ups-facts"><span>{{ icons.icon('power', 14) }}<b>{{ ups.rated_power_va ? ups.rated_power_va ~ ' VA' : '—' }}{% if ups.rated_power_w %} · {{ ups.rated_power_w }} W{% endif %}</b></span><span>{{ icons.icon('network', 14) }}<b>{{ ups.ip_address ?: '—' }}</b></span>{% if ups.battery_count or ups.battery_type %}<span>{{ icons.icon('battery', 14) }}<b>{{ ups.battery_count ? ups.battery_count ~ '× ' : '' }}{{ ups.battery_type ?: t('ups.battery_type_unknown') }}</b></span>{% endif %}<span class="battery-state battery-state-{{ ups.battery_state }}">{{ icons.icon('battery', 14) }}<b>{{ ups.battery_due_at ? t('ups.battery_due') ~ ' ' ~ ups.battery_due_at : t('ups.battery_unknown') }}</b></span></div>{% if ups.management_url %}<a class="ups-management-link" href="{{ ups.management_url }}" target="_blank" rel="noopener noreferrer">{{ icons.icon('external-link', 14) }}{{ t('ups.open_management') }}</a>{% endif %}</div>
                        <div class="ups-actions"><button class="icon-button" type="button" aria-label="{{ t('action.edit_ups') }}" title="{{ t('action.edit_ups') }}" data-ups-edit-open data-ups-id="{{ ups.id }}" data-ups-code="{{ ups.code }}" data-ups-name="{{ ups.name }}" data-ups-manufacturer="{{ ups.manufacturer }}" data-ups-model="{{ ups.model }}" data-ups-serial-number="{{ ups.serial_number }}" data-ups-rated-power-va="{{ ups.rated_power_va }}" data-ups-rated-power-w="{{ ups.rated_power_w }}" data-ups-ip-address="{{ ups.ip_address }}" data-ups-management-url="{{ ups.management_url }}" data-ups-battery-replaced-at="{{ ups.battery_replaced_at }}" data-ups-battery-interval="{{ ups.battery_replacement_interval_months }}" data-ups-battery-count="{{ ups.battery_count }}" data-ups-battery-type="{{ ups.battery_type }}" data-ups-status="{{ ups.operational_status|upper }}" data-ups-notes="{{ ups.notes }}">{{ icons.icon('edit', 15) }}</button><button class="icon-button danger" type="button" aria-label="{{ t('action.delete') }}" title="{{ t('action.delete') }}" data-delete-open data-delete-url="/api/v1/ups-devices/{{ ups.id }}" data-delete-name="{{ ups.code }} · {{ ups.name }}">{{ icons.icon('trash', 15) }}</button></div>
                    </article>
                    {% else %}<div class="inline-empty ups-empty">{{ t('ups.empty') }}</div>{% endfor %}
                </div>
            </div>
            <div class="rack-list">
                {% for rack in room.racks %}
                <a class="rack-row" href="/racks/{{ rack.id }}"><span class="rack-mini">{{ icons.icon('server', 18) }}</span><span><strong>{{ rack.code }} · {{ rack.name }}</strong><small>{{ rack.panels }} {{ t('common.panels') }} · {{ rack.units_used }}/{{ rack.units_total }}U</small></span><div class="mini-progress"><i style="width: {{ (rack.units_used / rack.units_total * 100)|round }}%"></i></div>{{ icons.icon('chevron', 16) }}</a>
                {% else %}<div class="inline-empty">{{ t('location.no_racks') }}</div>{% endfor %}
            </div>
            {% include 'components/asset-gallery.twig' with {
                images: room.images,
                upload_url: '/api/v1/server-rooms/' ~ room.id ~ '/images',
                input_id: 'room-image-upload-' ~ room.id,
                entity_code: room.code,
                title: t('photos.room_title'),
                subtitle: t('photos.room_subtitle')
            } %}
        </article>
        {% else %}<div class="empty-state"><h2>{{ t('location.no_rooms') }}</h2></div>{% endfor %}
    </div>
</section>

{% include 'components/asset-gallery.twig' with {
    images: location.images,
    upload_url: '/api/v1/locations/' ~ location.id ~ '/images',
    input_id: 'location-image-upload',
    entity_code: location.code,
    title: t('photos.location_title'),
    subtitle: t('photos.location_subtitle')
} %}

<dialog class="modal entity-modal" id="location-edit-modal">
    <form class="modal-card" data-location-edit-form data-location-id="{{ location.id }}">
        <div class="modal-head"><div><span class="eyebrow">{{ t('action.edit_location') }}</span><h2>{{ t('modal.location_edit_title') }}</h2><p>{{ location.code }}</p></div><button class="icon-button" type="button" data-location-edit-close aria-label="{{ t('action.close') }}">{{ icons.icon('close') }}</button></div>
        <div class="form-grid"><label class="field"><span>{{ t('form.location_code') }}</span><input name="code" maxlength="40" value="{{ location.code }}" required></label><label class="field"><span>{{ t('form.location_name') }}</span><input name="name" maxlength="160" value="{{ location.name }}" required></label><label class="field field-wide"><span>{{ t('form.address') }}</span><input name="address" maxlength="255" value="{{ location.address }}"></label></div>
        <div class="field field-wide"><span>{{ t('form.location_icon') }}</span>{% include 'components/location-icon-picker.twig' with {selected: location.icon_key} %}</div>
        <p class="form-error" data-form-error hidden></p><div class="modal-actions"><button class="button button-ghost" type="button" data-location-edit-close>{{ t('action.cancel') }}</button><button class="button button-primary" type="submit">{{ icons.icon('save') }}{{ t('action.save') }}</button></div>
    </form>
</dialog>

<dialog class="modal entity-modal" id="room-edit-modal">
    <form class="modal-card" data-room-edit-form>
        <input type="hidden" name="room_id" data-room-edit-id>
        <div class="modal-head"><div><span class="eyebrow">{{ t('action.edit_room') }}</span><h2>{{ t('modal.room_edit_title') }}</h2><p data-room-edit-context></p></div><button class="icon-button" type="button" data-room-edit-close aria-label="{{ t('action.close') }}">{{ icons.icon('close') }}</button></div>
        <div class="form-grid"><label class="field field-wide"><span>{{ t('form.location') }}</span><select name="location_id" data-room-edit-location required>{% for available_location in locations %}<option value="{{ available_location.id }}">{{ available_location.code }} · {{ available_location.name }}</option>{% endfor %}</select></label><label class="field"><span>{{ t('form.room_name') }}</span><input name="name" maxlength="160" required></label><label class="field"><span>{{ t('form.floor') }}</span><input name="floor" maxlength="40"></label>{% if not demo_mode %}<label class="field field-wide"><span>{{ t('form.room_sensor') }}</span><select name="sensor_id"><option value="">{{ t('form.room_sensor_none') }}</option>{% for sensor in sensor_options %}<option value="{{ sensor.id }}">{{ sensor.name }}</option>{% endfor %}</select><small>{{ t('form.room_sensor_hint') }}</small></label>{% endif %}</div>
        <p class="form-error" data-form-error hidden></p><div class="modal-actions"><button class="button button-ghost" type="button" data-room-edit-close>{{ t('action.cancel') }}</button><button class="button button-primary" type="submit">{{ icons.icon('save') }}{{ t('action.save') }}</button></div>
    </form>
</dialog>

<dialog class="modal entity-modal" id="room-modal">
    <form class="modal-card" data-room-form>
        <div class="modal-head"><div><span class="eyebrow">{{ t('action.add_room') }}</span><h2>{{ t('modal.room_title') }}</h2><p>{{ location.name }}</p></div><button class="icon-button" type="button" data-room-modal-close aria-label="{{ t('action.close') }}">{{ icons.icon('close') }}</button></div>
        <div class="form-grid"><label class="field field-wide"><span>{{ t('form.location') }}</span><select name="location_id" data-room-location required>{% for available_location in locations %}<option value="{{ available_location.id }}" {{ available_location.id == location.id ? 'selected' : '' }}>{{ available_location.code }} · {{ available_location.name }}</option>{% endfor %}</select><small>{{ t('form.location_current_hint') }}</small></label><label class="field"><span>{{ t('form.room_name') }}</span><input name="name" maxlength="160" placeholder="{{ t('form.room_name_hint') }}" required></label><label class="field"><span>{{ t('form.floor') }}</span><input name="floor" maxlength="40" placeholder="{{ t('form.floor_hint') }}"></label>{% if not demo_mode %}<label class="field field-wide"><span>{{ t('form.room_sensor') }}</span><select name="sensor_id"><option value="">{{ t('form.room_sensor_none') }}</option>{% for sensor in sensor_options %}<option value="{{ sensor.id }}">{{ sensor.name }}</option>{% endfor %}</select><small>{{ t('form.room_sensor_hint') }}</small></label>{% endif %}</div>
        <p class="form-error" data-form-error hidden></p>
        <div class="modal-actions"><button class="button button-ghost" type="button" data-room-modal-close>{{ t('action.cancel') }}</button><button class="button button-primary" type="submit">{{ icons.icon('plus') }}{{ t('action.create_room') }}</button></div>
    </form>
</dialog>

<dialog class="modal entity-modal" id="ups-modal">
    <form class="modal-card ups-modal-card" data-ups-form>
        <input type="hidden" name="server_room_id" data-ups-room-id>
        <div class="modal-head"><div><span class="eyebrow">{{ t('action.add_ups') }}</span><h2>{{ t('modal.ups_title') }}</h2><p data-ups-room-name></p></div><button class="icon-button" type="button" data-ups-modal-close aria-label="{{ t('action.close') }}">{{ icons.icon('close') }}</button></div>
        <div class="form-grid ups-form-grid"><label class="field"><span>{{ t('form.ups_name') }}</span><input name="name" maxlength="160" placeholder="{{ t('form.ups_name_hint') }}" required></label><label class="field"><span>{{ t('form.manufacturer') }}</span><input name="manufacturer" maxlength="120" placeholder="APC, Eaton, Vertiv"></label><label class="field"><span>{{ t('form.model') }}</span><input name="model" maxlength="120"></label><label class="field"><span>{{ t('form.serial_number') }}</span><input name="serial_number" maxlength="120"></label><label class="field"><span>{{ t('form.rated_power_va') }}</span><input name="rated_power_va" type="number" min="1" max="10000000" inputmode="numeric"></label><label class="field"><span>{{ t('form.rated_power_w') }}</span><input name="rated_power_w" type="number" min="1" max="10000000" inputmode="numeric"></label><label class="field"><span>{{ t('form.ip_address') }}</span><input name="ip_address" maxlength="45" placeholder="192.0.2.10"></label><label class="field"><span>{{ t('form.management_url') }}</span><input name="management_url" type="url" maxlength="2048" placeholder="https://192.0.2.10"></label><label class="field"><span>{{ t('form.battery_replaced_at') }}</span><input name="battery_replaced_at" type="date"></label><label class="field"><span>{{ t('form.battery_interval') }}</span><input name="battery_replacement_interval_months" type="number" min="1" max="240" value="36" required></label><label class="field"><span>{{ t('form.battery_count') }}</span><input name="battery_count" type="number" min="1" max="200" inputmode="numeric" placeholder="4"></label><label class="field field-wide"><span>{{ t('form.battery_type') }}</span><input name="battery_type" maxlength="160" placeholder="{{ t('form.battery_type_hint') }}"></label><label class="field field-wide"><span>{{ t('form.ups_status') }}</span><select name="operational_status"><option value="ACTIVE">{{ t('ups.status_active') }}</option><option value="MAINTENANCE">{{ t('ups.status_maintenance') }}</option><option value="ALARM">{{ t('ups.status_alarm') }}</option><option value="RETIRED">{{ t('ups.status_retired') }}</option></select></label><label class="field field-wide"><span>{{ t('form.notes') }}</span><textarea name="notes" maxlength="4000" rows="3" placeholder="{{ t('form.ups_notes_hint') }}"></textarea></label></div>
        <p class="form-error" data-form-error hidden></p><div class="modal-actions"><button class="button button-ghost" type="button" data-ups-modal-close>{{ t('action.cancel') }}</button><button class="button button-primary" type="submit">{{ icons.icon('plus') }}{{ t('action.create_ups') }}</button></div>
    </form>
</dialog>

<dialog class="modal entity-modal" id="ups-edit-modal">
    <form class="modal-card ups-modal-card" data-ups-edit-form>
        <input type="hidden" name="ups_device_id">
        <div class="modal-head"><div><span class="eyebrow">{{ t('action.edit_ups') }}</span><h2>{{ t('modal.ups_edit_title') }}</h2><p data-ups-edit-context></p></div><button class="icon-button" type="button" data-ups-edit-close aria-label="{{ t('action.close') }}">{{ icons.icon('close') }}</button></div>
        <div class="form-grid ups-form-grid"><label class="field"><span>{{ t('form.ups_name') }}</span><input name="name" maxlength="160" required></label><label class="field"><span>{{ t('form.manufacturer') }}</span><input name="manufacturer" maxlength="120"></label><label class="field"><span>{{ t('form.model') }}</span><input name="model" maxlength="120"></label><label class="field"><span>{{ t('form.serial_number') }}</span><input name="serial_number" maxlength="120"></label><label class="field"><span>{{ t('form.rated_power_va') }}</span><input name="rated_power_va" type="number" min="1" max="10000000" inputmode="numeric"></label><label class="field"><span>{{ t('form.rated_power_w') }}</span><input name="rated_power_w" type="number" min="1" max="10000000" inputmode="numeric"></label><label class="field"><span>{{ t('form.ip_address') }}</span><input name="ip_address" maxlength="45"></label><label class="field"><span>{{ t('form.management_url') }}</span><input name="management_url" type="url" maxlength="2048"></label><label class="field"><span>{{ t('form.battery_replaced_at') }}</span><input name="battery_replaced_at" type="date"></label><label class="field"><span>{{ t('form.battery_interval') }}</span><input name="battery_replacement_interval_months" type="number" min="1" max="240" required></label><label class="field"><span>{{ t('form.battery_count') }}</span><input name="battery_count" type="number" min="1" max="200" inputmode="numeric"></label><label class="field field-wide"><span>{{ t('form.battery_type') }}</span><input name="battery_type" maxlength="160"></label><label class="field field-wide"><span>{{ t('form.ups_status') }}</span><select name="operational_status"><option value="ACTIVE">{{ t('ups.status_active') }}</option><option value="MAINTENANCE">{{ t('ups.status_maintenance') }}</option><option value="ALARM">{{ t('ups.status_alarm') }}</option><option value="RETIRED">{{ t('ups.status_retired') }}</option></select></label><label class="field field-wide"><span>{{ t('form.notes') }}</span><textarea name="notes" maxlength="4000" rows="3"></textarea></label></div>
        <p class="form-error" data-form-error hidden></p><div class="modal-actions"><button class="button button-ghost" type="button" data-ups-edit-close>{{ t('action.cancel') }}</button><button class="button button-primary" type="submit">{{ icons.icon('save') }}{{ t('action.save') }}</button></div>
    </form>
</dialog>

<dialog class="modal entity-modal" id="rack-modal">
    <form class="modal-card" data-rack-form>
        <input type="hidden" name="server_room_id" data-rack-room-id>
        <div class="modal-head"><div><span class="eyebrow">{{ t('action.add_rack') }}</span><h2>{{ t('modal.rack_title') }}</h2><p data-rack-room-name></p></div><button class="icon-button" type="button" data-rack-modal-close aria-label="{{ t('action.close') }}">{{ icons.icon('close') }}</button></div>
        <div class="form-grid"><label class="field"><span>{{ t('form.rack_code') }}</span><input name="code" maxlength="40" placeholder="R01" required></label><label class="field"><span>{{ t('form.rack_name') }}</span><input name="name" maxlength="160" placeholder="{{ t('form.rack_name_hint') }}" required></label><label class="field"><span>{{ t('form.rack_units') }}</span><input name="total_units" type="number" min="1" max="60" value="42" required></label><label class="field"><span>{{ t('form.row_label') }}</span><input name="row_label" maxlength="40" placeholder="A"></label>{% if not demo_mode %}<label class="field field-wide"><span>{{ t('form.rack_sensor') }}</span><select name="sensor_id" data-rack-sensor-select><option value="">{{ t('form.room_sensor_none') }}</option>{% for sensor in sensor_options %}<option value="{{ sensor.id }}">{{ sensor.name }}</option>{% endfor %}</select><small>{{ t('form.rack_sensor_hint') }}</small></label>{% endif %}</div>
        <p class="form-error" data-form-error hidden></p>
        <div class="modal-actions"><button class="button button-ghost" type="button" data-rack-modal-close>{{ t('action.cancel') }}</button><button class="button button-primary" type="submit">{{ icons.icon('plus') }}{{ t('action.create_rack') }}</button></div>
    </form>
</dialog>
{% endblock %}
