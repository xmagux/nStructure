{% extends 'layouts/app.twig' %}
{% import 'components/icons.twig' as icons %}

{% block content %}
<section class="page-hero compact-hero">
    <div><span class="eyebrow">{{ t('topology.eyebrow') }}</span><h1>{{ t('topology.title') }}</h1><p>{{ t('topology.subtitle') }}</p></div>
    <div class="hero-actions"><button class="button button-ghost" type="button">{{ icons.icon('download') }}{{ t('action.export') }}</button></div>
</section>

<section class="topology-summary premium-summary">
    <div><span>{{ t('topology.locations') }}</span><strong>{{ topology.summary.locations }}</strong></div>
    <div><span>{{ t('topology.closures') }}</span><strong>{{ topology.summary.closures }}</strong></div>
    <div><span>{{ t('common.segments') }}</span><strong>{{ topology.summary.segments }}</strong></div>
    <div><span>{{ t('topology.total_length') }}</span><strong>{{ topology.summary.total_length }}</strong></div>
</section>

<section class="topology-workspace cytoscape-workspace">
    <div class="visualization-toolbar">
        <div class="toolbar-title"><span class="toolbar-kicker">LIVE MODEL</span><strong>{{ t('dashboard.network_map') }}</strong><span class="canvas-status"><i></i> Cytoscape</span></div>
        <div class="toolbar-tools">
            <span class="interaction-hint">{{ icons.icon('move') }}{{ t('visual.pan_zoom_hint') }}</span>
            <div class="tool-cluster">
                <button class="cad-tool" type="button" data-graph-zoom-out aria-label="{{ t('action.zoom_out') }}">{{ icons.icon('zoom-out') }}</button>
                <button class="cad-tool" type="button" data-graph-zoom-in aria-label="{{ t('action.zoom_in') }}">{{ icons.icon('zoom-in') }}</button>
                <button class="cad-tool" type="button" data-graph-fit aria-label="{{ t('action.fit_view') }}">{{ icons.icon('maximize') }}</button>
                <span class="tool-divider"></span>
                <button class="cad-tool" type="button" data-graph-fullscreen aria-label="{{ t('action.fullscreen') }}" title="{{ t('action.fullscreen') }}" data-label-enter="{{ t('action.fullscreen') }}" data-label-exit="{{ t('action.exit_fullscreen') }}"><span data-fullscreen-icon-enter>{{ icons.icon('expand') }}</span><span data-fullscreen-icon-exit hidden>{{ icons.icon('shrink') }}</span></button>
            </div>
        </div>
    </div>
    <div class="topology-main">
        <div class="network-canvas cytoscape-shell">
            <div class="canvas-grid"></div>
            <div class="cytoscape-canvas" data-cytoscape></div>
            <div class="map-legend">
                <span>{{ icons.icon('building', 15) }}{{ t('topology.legend_location') }}</span>
                <span>{{ icons.icon('splice', 15) }}{{ t('topology.legend_closure') }}</span>
                <span><i class="legend-line violet"></i>{{ t('topology.legend_sm') }}</span>
                <span><i class="legend-line amber dashed"></i>{{ t('topology.legend_partial') }}</span>
            </div>
        </div>
        <aside class="route-inspector" data-route-inspector>
            <div class="inspector-empty"><span class="empty-icon">{{ icons.icon('cable', 26) }}</span><h3>{{ t('topology.inspector') }}</h3><p>{{ t('topology.select_hint') }}</p></div>
        </aside>
    </div>
    <script type="application/json" class="topology-data">{{ topology|json_encode|raw }}</script>
</section>
{% endblock %}
